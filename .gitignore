# Gradle files
.gradle/
.kotlin/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log
*.bak

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
*.apkm
*.apks
*.xapk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# NPM modules
node_modules/

# Python bytecode caches
__pycache__/
*.pyc

# Instagram APK fixtures stay local: they are Meta's binaries and never go in the repo
fixtures/

# The release receipt scripts/build-release-receipt.ps1 writes. A release publishes it beside the
# bundle; it isn't committed.
release-receipt-*.json

# Local clones of the patch sources this bundle was assembled from (read, never committed).
# Reviewed source and carried-library license ledgers are tracked.
/sources/*
!/sources/instagram-sources.json
!/sources/carried-library-licenses.json

# Keep the selected marketing artwork and earlier concepts with the project; assets/ holds what ships.

# Local working notes
CLAUDE.md
CODEX_CHANGELOG.md
.claude/

# Research notes (regenerated by research passes)
RESEARCH.md
Roadmap_Blocked.md

# Keep working documents local; publish usage, release notes and the contributing guide.
*.md
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!docs/**/*.md

# One-off helper scripts never belong at the root
/*.py
