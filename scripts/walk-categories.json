{
  "schema": 1,
  "prerequisite": "HushGram settings",
  "categories": [
    {
      "id": "settings-privacy",
      "title": "Ads and privacy",
      "builder": "PrivacyCategory",
      "page": true,
      "when": {
        "op": "any_of",
        "conditions": [
          {
            "op": "any",
            "patches": [
              "Hide ads",
              "Sanitize sharing links",
              "Open links in external browser",
              "Spoof location",
              "App-only proxy",
              "Skip the contacts and location popups",
              "Skip the ad data reminder"
            ]
          },
          {
            "op": "at_least",
            "count": 2,
            "patches": [
              "View stories anonymously",
              "View live anonymously",
              "Read messages without the seen receipt",
              "View DM photos and videos anonymously",
              "Hide that you're typing",
              "Hide your active status",
              "Don't report screenshots"
            ]
          }
        ]
      },
      "anchors": [
        {
          "title": "Ghost mode",
          "when": {
            "op": "at_least",
            "count": 2,
            "patches": [
              "View stories anonymously",
              "View live anonymously",
              "Read messages without the seen receipt",
              "View DM photos and videos anonymously",
              "Hide that you're typing",
              "Hide your active status",
              "Don't report screenshots"
            ]
          }
        },
        {
          "title": "Hide ads",
          "when": {
            "op": "any",
            "patches": [
              "Hide ads"
            ]
          }
        }
      ]
    },
